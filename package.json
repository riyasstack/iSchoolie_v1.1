{
  "name": "ischoolie",
  "version": "0.1.0",
  "private": true,
  "description": "iSchoolie — a legacy (September 2020 layout) social network web application, running in isolated demo mode until real authentication is integrated.",
  "scripts": {
    "db:start": "tsx scripts/db-server.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "assets:brand": "tsx scripts/build-brand-assets.ts",
    "assets:seed": "tsx scripts/build-seed-assets.ts",
    "seed:check": "tsx scripts/seed-check.ts",
    "dev": "next dev --port 3000",
    "worker": "tsx scripts/worker.ts",
    "dev:all": "concurrently -k -n db,web,worker -c blue,green,magenta \"npm:db:start\" \"npm:dev\" \"npm:worker\"",
    "build": "prisma generate && next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-db-prepare.ts && vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "test:unit": "vitest run tests/unit",
    "live:bootstrap": "tsx scripts/live-bootstrap.ts",
    "dev:live": "node scripts/dev-live.mjs",
    "vercel-build": "prisma generate && next build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1178.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-query": "5.108.4",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "emojibase-data": "18.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "twitter-text": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/twitter-text": "3.1.10",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "embedded-postgres": "17.12.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "gifenc": "1.0.3",
    "jsdom": "31.0.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@embedded-postgres/windows-x64@17.12.0-beta.19": true,
    "esbuild@0.28.2": true
  }
}
