# --- Runtime mode -----------------------------------------------------------
# APP_MODE is independent of NODE_ENV.
#   demo: no login; each browser session gets an isolated, seeded demo workspace.
#   live: requires a real authentication provider (see AUTH_INTEGRATION.md).
#         Until one is configured, live mode refuses private reads and mutations.
APP_MODE=demo

# --- Database ---------------------------------------------------------------
# `npm run db:start` runs a project-local PostgreSQL 17 on port 54329 with data in
# .data/postgres. Point this at any PostgreSQL 15+ server instead if you prefer.
DATABASE_URL=postgresql://ischoolie:ischoolie@127.0.0.1:54329/ischoolie
EMBEDDED_PG_PORT=54329

# --- Sessions ---------------------------------------------------------------
# HMAC key for the opaque demo-session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value

# Demo workspace lifetime (days since last activity) before the worker deletes it.
DEMO_RETENTION_DAYS=7
# Max new demo workspaces per client IP per hour.
DEMO_PROVISION_LIMIT_PER_HOUR=20

# --- Media storage ------------------------------------------------------------
# local: files under STORAGE_DIR (survives restarts). See docs/ARCHITECTURE.md for
# the S3-compatible adapter contract used in production deployments.
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage

# Optional: set when the site is served over HTTPS so cookies get the Secure flag.
# (Detected automatically from the request protocol; this forces it on.)
FORCE_SECURE_COOKIES=false
